# WordPress Configuration
WP_SITE_URL=https://studytips.in
WP_USERNAME=your_wordpress_username
WP_APP_PASSWORD=your_wordpress_application_password

# LLM API Keys
OPENROUTER_API_KEY=your_openrouter_api_key
GITHUB_COPILOT_TOKEN=your_github_copilot_token
GITHUB_TOKEN=ghp_xxxx
NVIDIA_API_KEY=nvapi-xxxx
KIMI_API_KEY=your_kimi_moonshot_api_key

# Ollama (local LLM)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Google APIs
GOOGLE_ANALYTICS_PROPERTY_ID=your_ga4_property_id
GOOGLE_SEARCH_CONSOLE_SITE=https://studytips.in
GOOGLE_SERVICE_ACCOUNT_KEY=path/to/service-account-key.json

# Telegram Bot
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_ADMIN_CHAT_ID=your_telegram_chat_id

# Agent Settings
AGENT_MODE=interactive
DEFAULT_POST_STATUS=draft
CONTENT_LANGUAGE=en
MEMORY_DB_PATH=data/memory.db
CONTENT_CALENDAR_PATH=data/content_calendar.json

# Optional: Email Notifications
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
FROM_EMAIL=your_email@gmail.com
ADMIN_EMAIL=admin@studytips.in
